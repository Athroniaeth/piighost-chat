# piighost-chat configuration
# Copy to .env and adjust values as needed:
#   cp .env.example .env

# ── LLM (via LiteLLM proxy) ───────────────────────────
# All LLM calls go through a LiteLLM proxy (or any OpenAI-compatible
# gateway). LLM_MODEL must match an alias defined on the proxy.
LLM_MODEL=openai/gpt-5.4-mini
LLM_API_BASE=https://litellm.my-domain.com
LLM_API_KEY=sk-proxy-...

# ── PIIGhost API ───────────────────────────────────────
# Leave empty to disable auth on piighost-api
PIIGHOST_API_KEY=
# keyshield auth pepper for piighost-api (API-key hashing).
SECRET_PEPPER=
# piighost 1.0 encrypted Redis thread memory (pipeline.toml [memory]). Both are
# REQUIRED for piighost-api to boot. The cipher key is base64 of 16/24/32 bytes:
#   openssl rand -base64 32
PIIGHOST_HASH_PEPPER=
PIIGHOST_CIPHER_KEY=

# ── Ports ──────────────────────────────────────────────
FRONTEND_PORT=5173
BACKEND_PORT=8001
POSTGRES_PORT=5432

# ── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed origins for cross-origin requests
# (e.g. https://chat.example.com,https://app.example.com). Empty or
# unset means allow all (*), suitable for local dev only.
CORS_ALLOW_ORIGINS=

# ── Thread cleanup worker ─────────────────────────────
# Max age (seconds) before a thread is deleted by the hourly worker.
THREAD_TTL_SECONDS=3600
# If true, the worker logs stale threads but does not delete them.
CLEANUP_DRY_RUN=false

# ── Observation (optional) ─────────────────────────────
# Langfuse traces the LangChain agent in the chat backend. When
# LANGFUSE_PUBLIC_KEY is set, the agent emits traces to the project.
# Leave empty to disable agent tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# piighost-api is OpenTelemetry-native in 1.0: export the anonymization
# pipeline's spans to any OTLP backend. To send them to your Langfuse project,
# set both vars below (the observation extras are already in compose). Empty
# disables export.
#   endpoint (EU region): https://cloud.langfuse.com/api/public/otel
#   headers: build the auth string from your Langfuse keys, then:
#     AUTH=$(echo -n "$LANGFUSE_PUBLIC_KEY:$LANGFUSE_SECRET_KEY" | base64 -w 0)
#     OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic ${AUTH},x-langfuse-ingestion-version=4"
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
